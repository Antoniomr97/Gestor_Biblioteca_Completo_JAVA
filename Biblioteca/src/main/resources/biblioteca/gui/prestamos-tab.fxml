<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox fx:id="panePrestamos" prefHeight="200.0" prefWidth="100.0" spacing="20.0" visible="false" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.vista.gui.PrestamosController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Historial de Préstamos" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleAddPrestamo" styleClass="button-primary" text="+ Registrar Préstamo" />
            <Button mnemonicParsing="false" onAction="#handleReturnPrestamo" text="Devolución de Libro" />
         </children>
      </HBox>
      <TableView fx:id="tablePrestamos" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="colPreLibro" prefWidth="200.0" text="Libro">
                <cellValueFactory><PropertyValueFactory property="libro" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colPreUser" prefWidth="150.0" text="Usuario">
                <cellValueFactory><PropertyValueFactory property="usuario" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colPreFecha" prefWidth="120.0" text="Fecha Préstamo">
                <cellValueFactory><PropertyValueFactory property="fechaPrestamo" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colPreEstado" prefWidth="120.0" text="Estado">
                <cellValueFactory><PropertyValueFactory property="estado" /></cellValueFactory>
            </TableColumn>
         </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
