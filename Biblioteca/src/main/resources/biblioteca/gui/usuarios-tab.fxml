<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox fx:id="paneUsuarios" prefHeight="200.0" prefWidth="100.0" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.vista.gui.UsuariosController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Gestión de Usuarios" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleAddUsuario" styleClass="button-primary" text="+ Nuevo Usuario" />
            <Button mnemonicParsing="false" onAction="#handleDeleteUsuario" styleClass="button-danger" text="Eliminar Seleccionado" />
         </children>
      </HBox>
      <TableView fx:id="tableUsuarios" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colUserId" prefWidth="100.0" text="ID">
              <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
          </TableColumn>
          <TableColumn fx:id="colUserNombre" prefWidth="200.0" text="Nombre Completos">
              <cellValueFactory><PropertyValueFactory property="nombre" /></cellValueFactory>
          </TableColumn>
            <TableColumn fx:id="colUserEmail" prefWidth="250.0" text="Correo Electrónico">
                <cellValueFactory><PropertyValueFactory property="email" /></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colUserDireccion" prefWidth="190.0" text="Dirección">
                <cellValueFactory><PropertyValueFactory property="direccion" /></cellValueFactory>
            </TableColumn>
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </children>
</VBox>
