<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="700.0" prefWidth="1000.0" styleClass="main-container" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.vista.gui.MainController">
   <left>
      <VBox prefHeight="634.0" prefWidth="200.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnUsuarios" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showUsuarios" prefHeight="50.0" styleClass="sidebar-button" text="👥 Usuarios">
               <VBox.margin>
                  <Insets bottom="5.0" top="20.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="btnLibros" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showLibros" prefHeight="50.0" styleClass="sidebar-button" text="📚 Libros">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Button>
            <Button fx:id="btnPrestamos" alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showPrestamos" prefHeight="50.0" styleClass="sidebar-button" text="🔄 Préstamos">
               <VBox.margin>
                  <Insets bottom="5.0" />
               </VBox.margin>
            </Button>
            <VBox VBox.vgrow="ALWAYS" />
            <Button alignment="BASELINE_LEFT" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#closeApp" prefHeight="50.0" styleClass="sidebar-button" text="🚪 Salir">
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
   </left>
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <!-- ====== MENÚ ARCHIVO ====== -->
            <MenuBar styleClass="menu-bar">
               <menus>
                  <Menu mnemonicParsing="false" text="Archivo">
                     <items>
                        <MenuItem fx:id="menuCopiaSeguridad" mnemonicParsing="false" onAction="#hacerCopiaSeguridad" text="💾 Hacer copia de seguridad" />
                        <MenuItem fx:id="menuCargarCopia" mnemonicParsing="false" onAction="#cargarCopiaSeguridad" text="📂 Cargar copia de seguridad" />
                        <SeparatorMenuItem />
                        <MenuItem mnemonicParsing="false" onAction="#closeApp" text="🚪 Salir" />
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
            <!-- ====== HEADER TÍTULO ====== -->
            <HBox alignment="CENTER_LEFT" prefHeight="66.0" prefWidth="1000.0" styleClass="header">
               <children>
                  <Label styleClass="header-title" text="Biblioteca">
                     <font>
                        <Font name="System Bold" size="24.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <StackPane fx:id="contentArea" prefHeight="150.0" prefWidth="200.0" BorderPane.alignment="CENTER">
         <children>
            <fx:include fx:id="usuariosTab" source="usuarios-tab.fxml" />
            <fx:include fx:id="librosTab" source="libros-tab.fxml" />
            <fx:include fx:id="prestamosTab" source="prestamos-tab.fxml" />
         </children>
      </StackPane>
   </center>
</BorderPane>
