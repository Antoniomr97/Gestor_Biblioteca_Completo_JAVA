<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox fx:id="paneLibros" prefHeight="200.0" prefWidth="100.0" spacing="20.0" visible="false" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="biblioteca.vista.gui.LibrosController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="10.0">
         <children>
            <Label text="Gestión de Libros" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <HBox HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleAddLibro" styleClass="button-primary" text="+ Nuevo Libro" />
            <Button mnemonicParsing="false" onAction="#handleDeleteLibro" styleClass="button-danger" text="Eliminar Seleccionado" />
         </children>
      </HBox>
       <TableView fx:id="tableLibros" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
          <columns>
             <TableColumn fx:id="colLibroIsbn" prefWidth="130.0" text="ISBN">
                 <cellValueFactory><PropertyValueFactory property="isbn" /></cellValueFactory>
             </TableColumn>
             <TableColumn fx:id="colLibroTitulo" prefWidth="200.0" text="Título">
                 <cellValueFactory><PropertyValueFactory property="titulo" /></cellValueFactory>
             </TableColumn>
             <TableColumn fx:id="colLibroAnio" prefWidth="60.0" text="Año">
                 <cellValueFactory><PropertyValueFactory property="anio" /></cellValueFactory>
             </TableColumn>
             <TableColumn fx:id="colLibroCat" prefWidth="100.0" text="Categoría">
                 <cellValueFactory><PropertyValueFactory property="categoria" /></cellValueFactory>
             </TableColumn>
             <TableColumn fx:id="colLibroAutores" prefWidth="160.0" text="Autores">
                 <cellValueFactory><PropertyValueFactory property="autoresComoCadena" /></cellValueFactory>
             </TableColumn>
             <TableColumn fx:id="colLibroTipo" prefWidth="110.0" text="Tipo">
                 <cellValueFactory><PropertyValueFactory property="tipo" /></cellValueFactory>
             </TableColumn>
          </columns>
          <columnResizePolicy>
             <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
       </TableView>
   </children>
</VBox>
